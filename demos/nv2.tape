Output assets/nv2-demo.svg

Set FontSize 16
Set Width 960
Set Height 420
Set Shell bash
Set MarginColor "#0d1117"
Set Theme {
  "name": "nv2",
  "black": "#0d1117",
  "red": "#f85149",
  "green": "#3fb950",
  "yellow": "#e3b341",
  "blue": "#58a6ff",
  "magenta": "#a371f7",
  "cyan": "#39c5cf",
  "white": "#e6edf3",
  "brightBlack": "#8b949e"
}

Type "nv2_engine --version"
Enter
Sleep 600ms

Type "nv2_engine --help"
Enter
Sleep 800ms

Type "nv2_engine demo --mode terrain"
Enter
Sleep 1s

Type "# Voxel engine · MLP neural renderer · wgpu"
Enter
Sleep 500ms

Type "# Multiplayer over TCP · Epic Games Store integration"
Enter
Sleep 1s
