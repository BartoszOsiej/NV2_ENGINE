            if pos >= 0:
                start = pos - 1 if pos > 0 else 0
                blob = blob[:start] + blob[pos + len(needle):]
            if _h(blob) != _EXT_DRM_ARTIFACT_SHA:
                raise RuntimeError('Externum DRM: file was tampered with')
